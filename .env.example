# Copia este archivo como ".env" y completa con tus claves de Supabase.
# Las encontras en: Supabase -> tu proyecto -> Settings -> API
#
# El prefijo VITE_ es OBLIGATORIO: Vite solo expone al navegador las
# variables que empiezan con VITE_. Estas dos claves son publicas por
# diseno (la seguridad real la dan las politicas RLS en la base de datos).

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
